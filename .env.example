# -----------------------------
# Compose service ports (host)
# -----------------------------
POSTGRES_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=5173

# -----------------------------
# Database
# -----------------------------
POSTGRES_DB=crags
POSTGRES_USER=crags
POSTGRES_PASSWORD=crags
DATABASE_URL=postgresql+psycopg://crags:crags@postgres:5432/crags

# -----------------------------
# Auth / IAM
# -----------------------------
JWT_SECRET_KEY=change-me-local-dev-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
FRONTEND_ORIGINS=http://localhost:5173
AUTH_COOKIE_NAME=crags_session
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
# AUTH_COOKIE_DOMAIN=localhost

# Superadmin bootstrap (created on backend startup)
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_EMAIL=superadmin@crags.local
SUPERADMIN_PASSWORD=change-me
SUPERADMIN_GROUP_NAME=platform-admins
